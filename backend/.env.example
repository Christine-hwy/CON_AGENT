# MiniMax international account: TTS only (no GroupId required)
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_API_BASE=https://api.minimax.io
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_CONNECT_TIMEOUT_SECONDS=10
MINIMAX_REQUEST_TIMEOUT_SECONDS=180
MINIMAX_MAX_ATTEMPTS=3
MINIMAX_RETRY_BASE_SECONDS=1
MINIMAX_RETRY_MAX_SECONDS=8

# DeepSeek: single and batch dialogue script generation
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_ATTEMPTS=3
DEEPSEEK_CONTENT_MAX_ATTEMPTS=3
DEEPSEEK_RETRY_BASE_SECONDS=1
DEEPSEEK_RETRY_MAX_SECONDS=8
DEEPSEEK_BATCH_CONCURRENCY=2

# Configure every reusable speaker voice in one JSON array.
# The UI maps each dialogue role to one voice_id and reuses it for every turn.
MINIMAX_VOICES_JSON='[{"voice_id":"Cantonese_Articulate_commentator_vv2","name":"Cantonese Customer Service","language":"Yue"},{"voice_id":"Cantonese_casual_narrator_vv2","name":"Cantonese Customer","language":"Yue"}]'

MINIMAX_SAMPLE_RATE=32000
MINIMAX_BITRATE=128000
MINIMAX_AUDIO_FORMAT=mp3
MINIMAX_AUDIO_CHANNELS=1

MAX_UPLOAD_BYTES=5242880
MAX_DIALOGUE_TURNS=100
MAX_TURN_TEXT_CHARS=3000
MAX_TOTAL_TEXT_CHARS=30000
MAX_ROLES=10
MAX_SCENARIO_CHARS=10000
MAX_BATCH_SCENARIOS=10
DEFAULT_GAP_MS=250
MAX_GAP_MS=3000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FLASK_DEBUG=false

# Persistent AI Batch jobs
MAX_BATCH_AUDIO_COUNT=10
BATCH_JOB_CONCURRENCY=1
MINIMAX_BATCH_CONCURRENCY=1
BATCH_SIMILARITY_THRESHOLD=0.8
